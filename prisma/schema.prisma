generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  VIEWER
}

enum RatingSource {
  self_rated
  inferred
  demo
}

enum ProfileStatus {
  INVITED
  DRAFT
  SUBMITTED
  PUBLISHED
  RETURNED
  DEACTIVATED
}

enum SkillSource {
  PRIMARY
  SECONDARY
  PROFICIENT
  SELF_REPORTED
  AI_EXTRACTED
  LND_COMPLETION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  CLOSED
  UNKNOWN
}

enum ManualCapabilityTag {
  CUSTOMER_ENGINEERING
  INNOVATION_LAB
  PRODUCT_STRATEGY_VENTURE_STUDIO
}

enum CareerTimeframe {
  ZERO_TO_SIX_MONTHS
  SIX_TO_TWELVE_MONTHS
  ONE_TO_TWO_YEARS
  TWO_PLUS_YEARS
}

model Leader {
  id                       String                @id @default(cuid())
  fullName                 String
  preferredName            String?
  email                    String                @unique
  department               String?
  jobTitle                 String?
  role                     Role                  @default(LEADER)
  additionalCapabilityTags ManualCapabilityTag[] @default([])
  entraObjectId            String?               @unique
  profileStatus            ProfileStatus         @default(INVITED)
  invitedAt                DateTime?
  submittedAt              DateTime?
  publishedAt              DateTime?
  draftData                Json?
  experienceRaw            String?
  experienceYearsEstimate  Float?
  leadershipBracketRaw     String?
  leadershipYearsEstimate  Float?
  profileCompleted         Boolean               @default(false)
  lastProfileUpdate        DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  skills                   LeaderSkill[]
  tools                    LeaderTool[]
  projects                 Project[]
  certifications           Certification[]
  careerAspiration         CareerAspiration?
  snapshots                KpiSnapshot[]
  audits                   AuditLog[]
}

model Invitation {
  id         String    @id @default(cuid())
  email      String
  invitedBy  String
  dueAt      DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model NotificationJob {
  id          String    @id @default(cuid())
  kind        String
  recipient   String
  payload     Json
  scheduledAt DateTime
  sentAt      DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([scheduledAt, sentAt])
}

model Skill {
  id                String                  @id @default(cuid())
  name              String                  @unique
  category          String?
  needsReview       Boolean                 @default(false)
  aliases           SkillAlias[]
  leaders           LeaderSkill[]
  aspirationTargets CareerAspirationSkill[]
}

model SkillAlias {
  id      String @id @default(cuid())
  rawText String @unique
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model LeaderSkill {
  id           String       @id @default(cuid())
  leaderId     String
  skillId      String
  proficiency  Int          @default(3) @db.SmallInt
  ratingSource RatingSource
  source       SkillSource
  confidence   Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  leader       Leader       @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([leaderId, skillId, source])
}

model CareerAspiration {
  id                  String                  @id @default(cuid())
  leaderId            String                  @unique
  targetCapability    String?
  targetRole          String?                 @db.VarChar(60)
  targetTimeframe     CareerTimeframe?
  secondaryCapability String?
  notes               String?                 @db.VarChar(300)
  legacyJourneyBackup String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  leader              Leader                  @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  targetSkills        CareerAspirationSkill[]
}

model CareerAspirationSkill {
  leaderId          String
  skillId           String
  targetProficiency Int              @db.SmallInt
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  aspiration        CareerAspiration @relation(fields: [leaderId], references: [leaderId], onDelete: Cascade)
  skill             Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([leaderId, skillId])
  @@index([skillId])
}

model Project {
  id                     String        @id @default(cuid())
  leaderId               String
  name                   String
  description            String?
  techStack              String[]      @default([])
  client                 String?
  role                   String?
  durationText           String?
  durationMonthsEstimate Int?
  status                 ProjectStatus @default(UNKNOWN)
  rawText                String?
  confidence             Float?
  leader                 Leader        @relation(fields: [leaderId], references: [id], onDelete: Cascade)
}

model Certification {
  id                    String    @id @default(cuid())
  leaderId              String
  name                  String
  issuer                String?
  issuedAt              DateTime?
  expiresAt             DateTime?
  rawText               String?
  attachmentBlobName    String?   @unique
  attachmentContentType String?
  attachmentFileName    String?
  attachmentSize        Int?
  leader                Leader    @relation(fields: [leaderId], references: [id], onDelete: Cascade)
}

model Tool {
  id      String       @id @default(cuid())
  name    String       @unique
  leaders LeaderTool[]
}

model LeaderTool {
  leaderId String
  toolId   String
  leader   Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  tool     Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([leaderId, toolId])
}

model ReviewItem {
  id         String       @id @default(cuid())
  entityType String
  payload    Json
  confidence Float
  status     ReviewStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  leaderId   String?
  actorEmail String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  leader     Leader?  @relation(fields: [leaderId], references: [id], onDelete: SetNull)
}

model KpiSnapshot {
  id                 String   @id @default(cuid())
  leaderId           String
  quarter            String
  payload            Json
  skillCount         Int
  certificationCount Int
  createdAt          DateTime @default(now())
  leader             Leader   @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  @@unique([leaderId, quarter])
}
